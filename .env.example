# LLM provider: openai or vllm
AI_PROVIDER=openai

# OpenAI-compatible API settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=
LLM_MODEL_EVAL=

# vLLM OpenAI-compatible endpoint settings
VLLM_HOST=http://127.0.0.1
VLLM_LLM_PORT=30023
VLLM_LLM_MODEL=Qwen3-Next-80B-A3B
VLLM_USE_DEDICATED_MODELS=true

VLLM_ANALYZE_QUERY_MODEL=Qwen3-Next-80B-A3B
VLLM_ANALYZE_QUERY_PORT=30023
VLLM_EXTRACT_FACTS_MODEL=Qwen3-Next-80B-A3B
VLLM_EXTRACT_FACTS_PORT=30023
VLLM_UPDATE_PLAN_MODEL=Qwen3-Next-80B-A3B
VLLM_UPDATE_PLAN_PORT=30023
VLLM_REPLAN_CONDITIONS_MODEL=Qwen3-Next-80B-A3B
VLLM_REPLAN_CONDITIONS_PORT=30023
VLLM_GENERATE_FINAL_ANSWER_MODEL=Qwen3-Next-80B-A3B
VLLM_GENERATE_FINAL_ANSWER_PORT=30023

# Retrieval service
SEARCH_SERVICE_HOST=127.0.0.1
SEARCH_SERVICE_PORT=8091
SEARCH_SERVICE_ENDPOINT=/retrieve
TOP_K=5

# Optional runtime controls
FACT_EXTRACTION_MODE=two_stage
ENABLE_THINKING=false
USE_FINAL_ANSWER_REASONING=true
SHOW_RETRIEVED_CONTEXT=true
PROXY_ENABLED=false
PROXY_URL=
